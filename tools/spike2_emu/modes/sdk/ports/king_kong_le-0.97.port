data  wizard_obj_1    0x008a8080   # cmode_crash_the_gate
text  wizard_name_1   Crash the Gate
text  wizard_film_1   all five island scenes
data  wizard_obj_2    0x008a7640   # cmode_trex_battle, a multiball
text  wizard_name_2   T-Rex Battle
text  wizard_film_2   KING KONG spelled
data  wizard_obj_3    0x008a7738   # cmode_trex_boss_battle, a multiball
text  wizard_name_3   T-Rex Boss Battle
text  wizard_film_3   KING KONG spelled again

# ---- PAD-645: the framework's switch drain, for the flipper buttons' sounds in attract (portswitch.py; no `switch` lines: the shots keep their own route) ----
#   switch_edge: the framework's per-switch call in its switch drain (generation B: r0 = the switch id, called for every edge after the new level is stored) - press the switches to prove it
site switch_edge      0x0055fa04 0xe304337c 0xe3403093
#   switch_drain: the drain itself, never hooked: an edge counts only when switch_edge is called from it
site switch_drain     0x005606e4 0xe92d4ff0 0xe30e9c70
data switch_records         0x008ecc78
data switch_count           0x0093437c
value switch_drain_size     384
value switch_record_size    32
value switch_level_at       24
value switch_desc_via       8
value switch_flags_at       26
value switch_polarity_at    28
#   the drain's edges are not this port's shots (they keep their own route): only the flipper buttons' sounds in attract use it
value switch_edge_shots     0

# ---- PAD-641: the game's end-of-game high scores (it runs until a new high score's initials are in) ----
site  game_scores            0x00515604 0xe92d4ff0 0xe24dd0bc

# PAD-710: the game's own mode framework (mode_framework.py, from this build's program): what one of its
# modes writes as it starts and stops, so a mode of ours in one's place counts as it
site  mode_player            0x00371414 0xe3093088 0xe3403081
value mode_slot_stop         14
value mode_stopped_at        0x1b
value mode_reason_at         0x23
value mode_starts_at         0x5c
site  mode_started           0x00140b78 0xe3510021 0xe92d4008
data  mode_manager           0x008a05d0
value mode_id_at             4

# PAD-782: the attract mode's page table (portattract.py); an owner's attract items play between its pages
data  attract_table       0x00810928
value attract_entry_size  16
value attract_page_at     4
value attract_count       73
site  attract_sleep       0x0051f15c 0xe30b3c88 0xe340308e
# PAD-782: the scene show an attract item's page puts the video bank's scene on the glass with
site  attract_show        0x00517630 0xe92d4070 0xe30b4c8c



# ---- PAD-826: spare switch inputs and driver outputs (modes/spare_io.py --write, from this build's binary;
# docs/plans/mode_spare_io.md). coil_frame = the node-bus fire-by-address wrapper; sw_struct = the switch
# service's struct (+16 one 160-byte block per node: +20 its 64 input bits, +28 the switch id per bit); on the
# older framework sw_listen / sw_boards / coil_used instead (the listener table, the board table, a coil there)
site coil_frame            0x0068239c 0xe5d13000 0xe3530008
site coil_off              0x0067e488 0xe3510008 0xe1a02001
data sw_struct             0x008ecc78
data coil_count            0x008bc948
data coil_table            0x008c9a28

