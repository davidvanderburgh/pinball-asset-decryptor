# ---- PAD-1369: the game's challenge games, read off this program's own code (Star Wars ELG's PAD-1330 sites
# paired across and checked by shape) ----
# The balls-per-game getter (setting 80 / the player's game mode's own / Insider Connected's) is built into its
# callers, as on ELG: the balls of a player and of the current player are whole functions; the ball-number set
# (two ways), the last-ball test and the ball's end read it into a register and compare - set to 1 there in a
# mode's challenge game. The take-an-extra-ball test is the ball's end's first call after its bus question; the
# end of the ball (end(w0, w1): status bits 0x202, devices off) and the launch button's handler (flags 13 / 12,
# fire 8) as ELG's
site challenge_balls      0x003c69f0 0xd0001c01 0xf9467821
site challenge_balls_2    0x003c6ab0 0xd100c3ff 0xd0001c01
site challenge_balls_at_0 0x003c6bc8 0x6b1302bf 0x54000308
site challenge_balls_at_1 0x003c6c1c 0x6b1302bf 0xd0001c00
site challenge_balls_at_2 0x003c6cb0 0x6b13029f 0x52800000
site challenge_balls_at_3 0x003c6e6c 0x910a1ac0 0x39400401
site challenge_extra_ball 0x0028da90 0xb0002bc2 0x3962e041
site challenge_end_ball   0x0033ea50 0xd0002041 0xf942c421
site ball_launch          0x00339570 0xa9be53f3 0xf0002693
value challenge_on_flag   17   # FG_PLAYER_CHALLENGE_MODE_ACTIVE, read off the program's FG_ names
value challenge_balls_at_0_reg 19
value challenge_balls_at_1_reg 19
value challenge_balls_at_2_reg 19
value challenge_balls_at_3_reg 20
value ball_launch_flag       12   # FG_MBDEV_AUTO_PLUNGER_BALL_IN_DEVICE
value ball_launch_wait_flag  13   # FG_MBDEV_AUTO_PLUNGER_PLAYER_CONTROL
value challenge_menu_slot      -1   # a plain challenge: nothing of the game's to stop
# The start menu lists game-mode indices (Prolonged Competition's frame point, PAD-1327). One MODE CHALLENGE
# entry, Standard's index again, lettered CHALLENGE and the mode's name: its flippers step through the modes'
# own, the game plays a plain game and the ball's start makes it the mode's one-ball challenge game
site challenge_menu_frame 0x001d1f1c 0xb876d815 0x94031de4
value challenge_menu_frame_moved       1
value challenge_menu_frame_list_at     360
value challenge_menu_frame_count_at    156
value challenge_menu_frame_cap         4
value challenge_menu_frame_cursor_reg  22
value challenge_menu_frame_entry        1   # STANDARD
value challenge_menu_frame_caption_msg  1907   # STANDARD, lettered CHALLENGE while the cursor is on ours
value challenge_menu_frame_name_msg     1908   # NORMAL PLAY, lettered the mode's name
value challenge_menu_caption   1911   # CHALLENGE
value challenge_menu_sets_on   1    # the pick is a challenge game of the mode's (no flag of the game's)
