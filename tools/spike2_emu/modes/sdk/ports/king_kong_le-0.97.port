# ---- events: COPIED, unverified - prove them with event_probe.c (MODE_SDK.md, Events) ----

# ---- events: the framework's event bus, each seen firing in the emulator 2026-09-24 ----
event game_start     0x4d
event ball_start     0x25
event ball_end       0x34
event bonus_end      0x28
event tilt_warning   0xc8
event tilt           0xc6

# ---- callouts, heard in the emulator 2026-09-24 (item 163): the runtime's callout / callout_nth
# sites played each id and the game's audio was transcribed: countdown 668 (clips 1-5 said "ONE", "TOO", "THREE", "Four.", "Five"); time_up 670 ("TIME'S UP!")
callout countdown           668
callout time_up             670

# ---- clip v2 (item 164): the video bank scene's VideoSurface, played on the surface itself - the
# game draws it. The typed find is find_node + 0x2f4 and the surface's functions sit at Godzilla LE's
# distances from surface_state; each prologue equals Godzilla LE's. A clip was seen on the glass in
# the emulator 2026-09-25 (item 164).
site surface_find     0x006577e0 0xe92d4070 0xe24dd008
site surface_set_video 0x0064eec4 0xe5d030d4 0xe92d4ff0
site surface_play     0x0064ccd0 0xe5d030d4 0xe92d43f0
site surface_stop     0x0064c480 0xe5d030d4 0xe92d40f0
# Insider Connected score gate (item 166): the request header constructor (the endpoint in r1) and the
# message-begin thunk every sender calls next; the runtime refuses the score reports there
# (MODE_SDK.md, "Insider Connected: no score leaves a machine that carries modes")
site agent_header     0x006a4530 0xe92d40f8 0xe2505000
site agent_begin      0x006aee9c 0xe590c004 0xe1a00001

