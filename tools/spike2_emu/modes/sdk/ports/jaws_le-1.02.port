# ---- globals: data <name> <address> ---------------------------------------------------------
#   cur_player: derived from 2 places, e.g. 0x460b40+0x60
data cur_player             0x007c2098
#   scores: derived from 2 places, e.g. 0x4b8c60+0x8
data scores                 0x008a3850
#   mode_mask: derived from 2 places, e.g. 0x1c2d0+0xf8
data mode_mask              0x00874d0e
#   event_head: derived from 2 places, e.g. 0x52bb8+0x30
data event_head             0x008adaf8
