# ---- events: COPIED, unverified - prove them with event_probe.c (MODE_SDK.md, Events) ----

# ---- events: the framework's event bus, each seen firing in the emulator 2026-09-24 ----
event game_start     0x4d
event ball_start     0x25
event ball_end       0x34
event bonus_start    0x27
event bonus_end      0x28
event tilt_warning   0xc8
event tilt           0xc6
event game_over      0x47

# ---- callouts, heard in the emulator 2026-09-24 (item 163): the runtime's callout / callout_nth
# sites played each id and the game's audio was transcribed: countdown 212 (clips 1-5 said "ONE!", "TWO!", "FREE!", "FOUR!", "Five."); ten_seconds 222 ("Hurry!")
callout countdown           212
callout ten_seconds         222
value countdown_step 1

# ---- clip v2 (item 164): the video bank scene's VideoSurface, played on the surface itself - the
# game draws it. The typed find is find_node + 0x2f4; the surface's functions sit at layout A's
# distances from surface_state (godzilla_le-1.16), each prologue equal to it. A clip was seen on the glass in
# the emulator 2026-09-25 (item 164).
site surface_find     0x00444cf8 0xe92d4070 0xe24dd008
site surface_set_video 0x0043c3dc 0xe5d030d4 0xe92d4ff0
site surface_play     0x0043a1e8 0xe5d030d4 0xe92d43f0
site surface_stop     0x00439998 0xe5d030d4 0xe92d40f0
# Insider Connected score gate (item 166): the request header constructor (the endpoint in r1) and the
# message-begin thunk every sender calls next; the runtime refuses the score reports there
# (MODE_SDK.md, "Insider Connected: no score leaves a machine that carries modes")
site agent_header     0x00491a48 0xe92d40f8 0xe2505000
site agent_begin      0x0049c3b4 0xe590c004 0xe1a00001

# ---- examples a template mode can use on this game ----
text example_start_shot     Left 2 bank target bottom

