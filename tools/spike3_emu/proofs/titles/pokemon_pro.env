# Pokemon Pro 0.87 (Spike 3) - its card, port and switch names for s3proof.sh / play.sh (TITLE=pokemon_pro, PAD-1506).
# Masks are ports/spike3/pokemon_pro-0.87.port's switch lines: BERRY TARGET LEFT 0x40; LEFT ORBIT 0x10000, REAR RAMP
# MADE 0x40000, CAPTIVE BALL-TARGET 0x2000000000 (the Pro has no Bowl opto, so its lines sit one bit below the LE's).
CARD=${CARD:-pokemon_pro-0_87_0_spike3.Release.64G.sdcard-secure.raw}
PORTNAME=${PORTNAME:-pokemon_pro-0.87.port}
MODES=${MODES:-$HERE/modes/pokemon_pro}
TRIGGER_SW=${TRIGGER_SW:-BERRY TARGET LEFT}
SHOT_SWS=${SHOT_SWS:-LEFT ORBIT|REAR RAMP MADE|CAPTIVE BALL-TARGET}
EARLY_SWS=${EARLY_SWS:-LEFT ORBIT|BERRY TARGET CENTER}
COINS=${COINS:-4}                       # as the LE: not on free play
START_HOLD_MS=${START_HOLD_MS:-0}
FLIP_SWS=${FLIP_SWS:-LEFT FLIPPER BUTTON|RIGHT FLIPPER BUTTON}
