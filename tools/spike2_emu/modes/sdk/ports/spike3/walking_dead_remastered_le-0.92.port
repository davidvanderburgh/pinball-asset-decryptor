# PAD-1326: co-op play - the framework's player change, add player and player bytes, read off the program by
# portcoop.lines_a64 (the same shapes as Star Wars ELG 1.10's paired lines; the ball is the byte after the player's)
site coop_player_change 0x00360d80 0xb0002242 0xf9468442
site coop_add_player  0x00360940 0xa9be53f3 0x52800a00
data coop_player            0x007b8f10
data coop_players           0x00885e50
# the message table and its "BALL %d" line (portcoop.message_lines_a64), the line that says whose turn it is
data message_table          0x007e6328
value coop_ball_msg          1254

# ---- PAD-1327 (emulator-proven 2026-11-16: entry on the menu, picked, game 1 played as Competition): the start menu (CHOOSE YOUR MODE OF PLAY), read off this program's own menu function 0x1ee480: Star Wars
# ELG's shape - entries {u32 kind, u16 caption, u64 name} 16 bytes each on its stack at sp+0x128, room for 8 (0x1a8 is
# the next object), the count in w22 until 0x1ef564 keeps the LAST index at sp+204 for the loop; every frame 0x1ef5ec
# reads the kind under the cursor into w0 and the kind's flags follow (2: COMPETITION, flag 17). Prolonged
# Competition (comp.cfg) is appended there (hook_full: x22 the count) and played as Standard once picked.
site challenge_menu      0x001ef564 0x510006c0 0x52a88e02
site challenge_menu_pick 0x001ef5f0 0x7100101f 0x54005f20
value challenge_menu_list_at   296
value challenge_menu_count_reg 22
value challenge_menu_cap       8
value challenge_menu_entry     16
value challenge_menu_pick_reg  0
