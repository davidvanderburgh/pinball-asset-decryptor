+
+/* PAD-1090: Linux spidev SPI_IOC_MESSAGE(n). The transfer array is n fixed
+ * 32-byte records; each one's tx_buf/rx_buf is a guest address. */
+static abi_long do_ioctl_spi_msg(const IOCTLEntry *ie, uint8_t *buf_temp,
+                                 int fd, int cmd, abi_long arg)
+{
+    uint32_t n = (((uint32_t)cmd >> 16) & 0x3fff) / sizeof(struct spi_ioc_transfer);
+    struct spi_ioc_transfer *t, *h;
+    void **tx, **rx;
+    uint32_t i;
+    abi_long ret = 0;
+
+    (void)buf_temp;
+    if (n == 0 || n > 16) {
+        return -TARGET_EINVAL;
+    }
+    t = lock_user(VERIFY_READ, arg, n * sizeof(*t), 1);
+    if (!t) {
+        return -TARGET_EFAULT;
+    }
+    h = g_new0(struct spi_ioc_transfer, n);
+    tx = g_new0(void *, n);
+    rx = g_new0(void *, n);
+    for (i = 0; i < n; i++) {
+        uint32_t len = tswap32(t[i].len);
+        abi_ulong gt = tswap64(t[i].tx_buf), gr = tswap64(t[i].rx_buf);
+
+        h[i] = t[i];
+        h[i].len = len;
+        h[i].tx_buf = 0;
+        h[i].rx_buf = 0;
+        if (len && gt) {
+            tx[i] = lock_user(VERIFY_READ, gt, len, 1);
+            if (!tx[i]) {
+                ret = -TARGET_EFAULT;
+                goto out;
+            }
+            h[i].tx_buf = (uintptr_t)tx[i];
+        }
+        if (len && gr) {
+            rx[i] = lock_user(VERIFY_WRITE, gr, len, 0);
+            if (!rx[i]) {
+                ret = -TARGET_EFAULT;
+                goto out;
+            }
+            h[i].rx_buf = (uintptr_t)rx[i];
+        }
+    }
+    ret = get_errno(safe_ioctl(fd, ie->host_cmd, h));
+out:
+    for (i = 0; i < n; i++) {
+        uint32_t len = tswap32(t[i].len);
+        if (tx[i]) {
+            unlock_user(tx[i], tswap64(t[i].tx_buf), 0);
+        }
+        if (rx[i]) {
+            unlock_user(rx[i], tswap64(t[i].rx_buf), is_error(ret) ? 0 : len);
+        }
+    }
+    g_free(h);
+    g_free(tx);
+    g_free(rx);
+    unlock_user(t, arg, 0);
+    return ret;
+}
+
 IOCTLEntry ioctl_entries[] = {
 #define IOCTL(cmd, access, ...) \
     { TARGET_ ## cmd, cmd, #cmd, access, 0, {  __VA_ARGS__ } },
