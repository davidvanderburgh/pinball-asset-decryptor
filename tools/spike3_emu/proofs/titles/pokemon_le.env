# Pokemon LE 0.82 (PAD-1289): the card, its port and its switch names for s3proof.sh / play.sh (TITLE=pokemon_le).
# Masks are the port's switch lines: BERRY TARGET LEFT 0x80; LEFT ORBIT 0x40000, REAR RAMP MADE 0x100000,
# CAPTIVE BALL-TARGET 0x8000000000.
CARD=${CARD:-pokemon_le-0_82_0.Release.64G.sdcard-secure.raw}
PORTNAME=${PORTNAME:-pokemon_le-0.82.port}
MODES=${MODES:-$HERE/modes/pokemon_le}
TRIGGER_SW=${TRIGGER_SW:-BERRY TARGET LEFT}
SHOT_SWS=${SHOT_SWS:-LEFT ORBIT|REAR RAMP MADE|CAPTIVE BALL-TARGET}
EARLY_SWS=${EARLY_SWS:-LEFT ORBIT|BERRY TARGET CENTER}
COINS=${COINS:-4}                       # Pokemon LE 0.82 is not on free play (attract: CREDITS 0)
START_HOLD_MS=${START_HOLD_MS:-0}       # no first-boot GAME SETUP screen to hold Start through
FLIP_SWS=${FLIP_SWS:-LEFT FLIPPER BUTTON|RIGHT FLIPPER BUTTON}       # PAD-1327: this title's own names (L/R FLIPPER BUTTON do not exist here)
