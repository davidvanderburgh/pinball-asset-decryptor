# Star Wars 2025 LE 0.96 (Spike 3) - its card, port and switch names for s3proof.sh / play.sh (TITLE=star_wars_2025_le,
# PAD-1290). Bits are ports/spike3/star_wars_2025_le-0.96.port's switch lines (ids from the rig census beside this file):
# Right target 0x80; Left orbit 0x400, At-at target 0x800, Right orbit 0x800000.
CARD=${CARD:-star_wars_2025_le-0_96_0.Release.64G.sdcard-secure.raw}
PORTNAME=${PORTNAME:-star_wars_2025_le-0.96.port}
TRIGGER_SW=${TRIGGER_SW:-RIGHT TARGET}
SHOT_SWS=${SHOT_SWS:-LEFT ORBIT|AT-AT TARGET|RIGHT ORBIT}
EARLY_SWS=${EARLY_SWS:-LEFT ORBIT|RIGHT ORBIT}
TRIGGER_BITS=${TRIGGER_BITS:-0x80}
SHOT_BITS=${SHOT_BITS:-0x800c00}
COINS=${COINS:-4}
START_HOLD_MS=${START_HOLD_MS:-0}
FLIP_SWS=${FLIP_SWS:-LEFT FLIPPER BUTTON|RIGHT FLIPPER BUTTON}       # PAD-1327: this title's own names (L/R FLIPPER BUTTON do not exist here)
