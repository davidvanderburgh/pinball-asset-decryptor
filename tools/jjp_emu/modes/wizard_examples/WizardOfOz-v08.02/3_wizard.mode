# A wizard mode for WizardOfOz-v08.02: it starts once the player has played these 4 of the game's own
# modes in one game, or when PAD WIZARD is picked on the attract menu (hold both flipper
# buttons a second in attract).  Every key: tools/jjp_emu/MODES.md
name = PAD Wizard
title = PAD WIZARD
start_all = cbm_proc ecmb_run_proc fireball_frenzy_run_proc haunted_run_proc
game_type = PAD WIZARD
shots = switch_ramp_made switch_l_orbit_hi switch_r_orbit_hi
points = 3000000
points_ladder = rising
multiball = 3 20
seconds = 0
sound_start = se_fanfare_ecmbstart0
sound_shot = se_wz_wzjackpot
