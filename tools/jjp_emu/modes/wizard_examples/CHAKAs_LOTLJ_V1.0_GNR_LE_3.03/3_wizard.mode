# A wizard mode for CHAKAs_LOTLJ_V1.0_GNR_LE_3.03: it starts once the player has played these 4 of the game's own
# modes in one game, or when PAD WIZARD is picked on the attract menu (hold both flipper
# buttons a second in attract).  Every key: tools/jjp_emu/MODES.md
name = PAD Wizard
title = PAD WIZARD
start_all = AFDMode CDMode ComaMode SongMode
game_type = PAD WIZARD
shots = switch_target_jam switch_orbit_left_hi switch_orbit_right_hi
points = 3000000
points_ladder = rising
multiball = 3 20
seconds = 0
sound_start = se_FX_GnR_AM_AFD_Intro
sound_shot = se_Fanfare_GnR_Amps_Jackpot
