# A multiball of the mode's own for Pirates-v01.01: 3 balls, 10 s ball save, one ball left
# ends it (seconds = 0: no clock).  Every key: tools/jjp_emu/MODES.md
name = PAD Multiball
title = PAD MULTIBALL
start = switch_l_orbit_hi
shots = switch_upf_target_1 switch_l_orbit_hi switch_l_ramp_made
points = 2000000
seconds = 0
multiball = 3 10
add_ball = switch_upf_target_1 1
coil_shot = coil_knocker
sound_shot = se_Fanfare_TreasureHoard_Jackpot
