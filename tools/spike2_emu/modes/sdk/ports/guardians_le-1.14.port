# ---- a mode's own screen goes in this scene: drawn every frame of a game (item 164, the RadiumScene census)
scene hud                  4853b69e9fd122157772aaac5db81948331def2b

# ---- the game's own modes (item 165): the framework's LIVE RECORDS. Every timed mode's start begins by
# asking 0x186f08(lo, hi) whether one of its own records is alive (a walk of the list at [0x5bc478]: u16 id at +0,
# next at +0x84) and refuses to start while one is; asked by the runtime, it says the mode is running.
# Each mode's ids are read off its start (or the function reading its timer adjustment) in the stock table.
site live_records          0x00186f08 0xe30c2478 0xe340205b
# Insider Connected score gate (item 166): the request header constructor (the endpoint in r1) and the
# message-begin thunk every sender calls next; the runtime refuses the score reports there
# (MODE_SDK.md, "Insider Connected: no score leaves a machine that carries modes")
site agent_header     0x004896a8 0xe92d40f8 0xe2505000
site agent_begin      0x00494004 0xe590c004 0xe1a00001
value mode_records_1       0x00ec00ea      # Super Scoring: ids 234..236
text mode_records_name_1   Super Scoring
value mode_records_2       0x00e900e8      # Double Scoring: ids 232..233
text mode_records_name_2   Double Scoring
