# Fallout LE 0.82 (PAD-1288): the card, its port and its switch names for s3proof.sh / play.sh (TITLE=fallout_le).
# Masks are the port's switch lines: JUNK TARGET 0x40; POP TARGET-LEFT 0x80, RADIO TOWER TARGET 0x8000,
# 3 BANK-TOP 0x10000 (modes/fallout_le/*.cfg: trigger 0x40 x3, shots 0x18080).
CARD=${CARD:-fallout_le-0_82_0_spike3.Release.64G.sdcard-secure.raw}
PORTNAME=${PORTNAME:-fallout_le-0.82.port}
MODES=${MODES:-$HERE/modes/fallout_le}
TRIGGER_SW=${TRIGGER_SW:-JUNK TARGET}
SHOT_SWS=${SHOT_SWS:-POP TARGET-LEFT|RADIO TOWER TARGET|3 BANK-TOP}
EARLY_SWS=${EARLY_SWS:-POP TARGET-LEFT|3 BANK-TOP}
FLIP_SWS=${FLIP_SWS:-LEFT FLIPPER BUTTON|RIGHT FLIPPER BUTTON}       # PROOF=edge
NOHANDLER_SWS=${NOHANDLER_SWS:-RIGHT SLINGSHOT|LEFT POP BUMPER}      # PROOF=edge
START_HOLD_MS=${START_HOLD_MS:-0}       # no first-boot GAME SETUP screen
ATTRACT_WAIT=${ATTRACT_WAIT:-110}       # its Fat Man steppers home first (docs/plans/spike3_emulation.md, Stage 7)
COINS=${COINS:-4}                       # not on free play
AFTER_START_SWS=${AFTER_START_SWS:-ACTION BUTTON}   # the character select
