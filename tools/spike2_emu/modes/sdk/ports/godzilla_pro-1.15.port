# ---- named inserts (item mode-leds): MODE_SDK.md "Lights: named inserts" ----------------------------
# The game's lamp LAYERS (lamp groups): the active list's head is the word after the free list's at
# lamp_layers; each group holds a pointer to one 40-byte slot per light (+0), its priority (+4), its
# event (+16) and the next group (+20). Every frame the compositor walks the list bottom to top and
# each slot whose byte +3 is set gives its light the level at +2 (fade at +8). Read at the desk off
# this build (allocator 0x3c14d4, compositor 0x3bfb00) (the allocator, the pool, the compositor).
data lamp_layers            0x007dd4e8
data light_count            0x007b10b4
value lamp_slot_size        40
value lamp_slot_level       2
value lamp_slot_alpha       3
value lamp_slot_fade        8
value lamp_slot_used        36
value lamp_group_prio       4
value lamp_group_next       20
# the fade time a held insert's level carries: the game's own in-play inserts carry 3 (read live, RUN 2)
value lamp_fade             3
