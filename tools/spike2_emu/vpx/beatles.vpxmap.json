{
  "_": [
    "beatles on 'The Beatles' (Original 2018) v007 (VPForums): Stern's Beatles playfield",
    "(a Seawitch body) whose brain was Stern's 1980 Seawitch ROM (seawitfp), plus a",
    "script of its own on top (modes, ball save, a lock, mystery, skill shots, PuP).",
    "This map is what patch_beatles.py applies to its script, and what padcontroller.py",
    "serves. Numbers: switch 1000+id (switch_list.txt), lamp 1000+node*100+index",
    "(led_io.txt), solenoid: the small number under `solenoids` (the Seawitch ROM's own",
    "where it had the coil, so DOF's seawitfp config still finds them).",
    "Positions: VP units, 956 x 1979; table = (3.251*x - 0.0076*y - 65.3,",
    "-0.0869*x + 3.239*y - 157.4) from the drawing's 336 x 710, fitted on 29 switches",
    "(rms 18 table units, about 6 drawing px)."
  ],
  "title": "beatles",
  "detect": ["seawitfp", "Beatles"],
  "output": "The Beatles_007 (PAD).vpx",
  "patcher": "patch_beatles.py",
  "table": {"name": "The Beatles (Original 2018) v007", "by": "an author the table does not name", "where": "VPForums"},
  "game_on": {
    "_": "a synthetic solenoid for core.vbs's GameOnSolenoid (UseSolenoids=2, fast flips): ON while the flipper coils' board rules are armed",
    "number": 40, "coils": [[8, 5], [8, 0]]
  },
  "cabinet": {
    "start": 1034, "tilt": 1035, "slam": 1042,
    "left_flipper": 1056, "right_flipper": 1055, "up_left_flipper": 1058, "up_right_flipper": 1057,
    "coin1": 1036, "coin2": 1037, "coin3": 1038,
    "coin_door_interlock": 1033
  },

  "switch_rewrite": {
    "_": "the table's Seawitch number -> Spike 2 switch id (0 = no Spike 2 switch: the edge is dropped)",
    "4": 71,
    "9": 91, "10": 89, "14": 90,
    "12": 61, "13": 60,
    "17": 76, "18": 75, "19": 74, "20": 73,
    "21": 85, "22": 86, "23": 87, "24": 88,
    "29": 78, "30": 79, "31": 80, "32": 81,
    "38": 54, "39": 53, "40": 52,
    "34": 48, "35": 51, "36": 49, "37": 50,
    "25": 83
  },
  "switch_by_object": {
    "_": "edges sent by an object whose old number was shared: both spinners pulsed Seawitch's 5",
    "sw5_Spin": 82, "leftspin_Spin": 92
  },
  "switch_subs": {
    "_": "objects the Seawitch script never sent a switch for (the tribute's own targets and triggers): their subs become these edges",
    "LiteMysteryTarget1_Hit": {"pulse": 77, "name": "LEFT ORBIT TARGET"},
    "LiteMysteryTarget2_Hit": {"pulse": 84, "name": "RIGHT ORBIT TARGET"},
    "MysteryTarget_Hit": {"pulse": 43, "name": "LOWER LEFT TARGET"},
    "superjt_hit": {"pulse": 44, "name": "SUPER JACKPOT TARGET"},
    "sw25_Hit": {"hold": 83, "name": "SKILL SHOT ROLLOVER (the star under the upper right flipper)"},
    "pupballstart_hit": {"hold": 59, "name": "SHOOTER LANE (where the ball rests on the plunger)"},
    "flash2_hit": {"pulse": 70, "keep": true, "name": "LEFT ORBIT OPTO"},
    "flash4_hit": {"pulse": 72, "keep": true, "name": "RIGHT ORBIT OPTO"}
  },
  "repatch": [
    {"old": "bsTrough.Balls = 6", "why": "it serves two balls at Start", "since": "PAD-933: the trough holds the four balls the game counts"},
    {"old": ".InitMagnet PadRecordMagnet, 30", "why": "the record's magnet catches the ball and drops it down the middle", "since": "PAD-950: the record's magnet pulls without grabbing"},
    {"old": "' the record turns on its motor's two LED channels (MOTOR A0 / A1 DRIVER)", "why": "the record spins up too slowly to throw the ball its magnet caught", "since": "PAD-965: the record spins up as the game runs it"}
  ],
  "switch_holds": {
    "_": "switches held while a ball sits somewhere (cvpmBallStack serves them)",
    "trough": [68, 67, 66, 65, 64, 63, 69],
    "balls": 4,
    "balls_why": "the game counts 4 balls installed (TROUGH 1..4); with six on the rig it fired TROUGH until the trough read 3 - three balls served at Start (PAD-933), with four it fires once"
  },
  "quiet_subs": {
    "_": "the tribute's own rules, emptied: the real game scores, lights, saves and locks. Their callers stay; these do nothing now",
    "subs": [
      "SolBallRelease", "CheckBeatlemania", "AddTurntableTime", "CheckDTFrenzy", "CheckSuperSpinner",
      "CheckSuperPopBumper", "CheckLoopMania", "checkfab", "checkletters", "dropem", "SetDTState",
      "AddPoints", "AddPointsTimer_Timer", "flashdrum", "bumperflashing", "NextMode", "StartMode",
      "EndMode", "ResetModes", "ModeCycleTimer_Timer", "EndMystery", "ClearMysteryDisplay",
      "AddMultiBall", "SkillshotFlasher", "Endskillshot", "Skillshottimer_timer",
      "LoopSkillshot1_hit", "LoopSkillshot2_hit", "LoopSkillshot3_hit", "TopSkillshot_Hit",
      "StartSkillshot_Hit", "StartSkillshotTimer_Hit", "EndSkillshot1_hit", "EndSkillshot2_hit",
      "LoopMania1_Hit", "LoopMania2_Hit", "predrain_hit", "AddSavedBall", "superjball_hit",
      "releaser_hit", "bsactive_hit", "pupballstart1_hit", "ResetDropTargets", "LiftDTLBank",
      "magnettime_timer", "spinflash_timer", "DisplayTimer_Timer", "quotes_timer",
      "gamechange_timer", "addtllightsoff"
    ]
  },

  "solenoid_max": 68,
  "solenoids": {
    "_": [
      "Spike 2 coil [node, index] -> the SMALL number the table script sees it as (core.vbs",
      "indexes SolCallback(68) by it); the flippers keep core.vbs's own Consts (sLRFlipper 46,",
      "sLLFlipper 48, sULFlipper 36, sURFlipper 34). 7-10 are Seawitch's own numbers for the",
      "same jobs; `dof: null` where Seawitch had no such coil."
    ],
    "7":  {"coil": [9, 5], "name": "CENTER 4 BANK DROP", "callback": "dtBank.SolDropUp"},
    "8":  {"coil": [8, 8], "name": "LEFT 3 BANK DROP", "callback": "dtLBank.SolDropUp"},
    "9":  {"coil": [9, 1], "name": "RIGHT 4 BANK DROP", "callback": "dtRBank.SolDropUp"},
    "10": {"coil": [8, 1], "name": "TROUGH", "callback": "bsTrough.SolOut"},
    "1":  {"coil": [8, 4], "name": "AUTO PLUNGER", "callback": "PadAutoPlunger", "dof": null},
    "2":  {"coil": [9, 6], "name": "MAGNET-TOP", "magnet": "MagnetW2", "dof": null},
    "3":  {"coil": [9, 0], "name": "MAGNET-RECORD", "magnet": "mRecordMagnet", "dof": null,
           "strength": 10, "grab": false,
           "why": "the game only pulses it, in bursts of about 0.4 + 0.15 + 0.08 s as a ball crosses TOP MAGNET OPTO (emulator, PAD-950); a grabbing magnet pinned a ball on the record dead centre and dropped it down the middle, a strength 10 pull bends its path"},
    "4":  {"coil": [9, 2], "name": "LEFT POP BUMPER", "callback": null, "dof": null},
    "5":  {"coil": [9, 3], "name": "RIGHT POP BUMPER", "callback": null, "dof": null},
    "11": {"coil": [9, 4], "name": "TOP POP BUMPER", "callback": null, "dof": null},
    "12": {"coil": [8, 2], "name": "RIGHT SLINGSHOT", "callback": null, "dof": null},
    "13": {"coil": [8, 3], "name": "LEFT SLINGSHOT", "callback": null, "dof": null},
    "46": {"coil": [8, 0], "name": "RIGHT FLIPPER", "callback": "SolRFlipper"},
    "48": {"coil": [8, 5], "name": "LEFT FLIPPER", "callback": "SolLFlipper"},
    "36": {"coil": [8, 6], "name": "UP LEFT FLIPPER", "callback": "SolULFlipper", "dof": null},
    "34": {"coil": [8, 7], "name": "UP RIGHT FLIPPER", "callback": "SolURFlipper", "dof": null}
  },

