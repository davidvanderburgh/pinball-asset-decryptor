value ebirah_rule           12
value ebirah_spin_left_at   0x8c      # + 4 * player, spins left on the Left spinner (15 at a refill)
value ebirah_spin_top_at    0x9c      # Top spinner (40)
value ebirah_spin_shield_at 0xac      # Shield ramp spinner (15)
value ebirah_stage_count_at 0xbc      # + 4 * player: stages done (the 2-stage RuleCities/RuleAllies mark reads it)
value ebirah_stage_index_at 0xd0      # which of 5M / 10M / 15M is next (START resets it)
value ebirah_kotm_at        0xd4      # byte: King of the Monsters runs (awards go to rule 20)
value ebirah_spin_left_bit  0x200     # the raw shot bits the handler tests (each spinner's middle bit)
value ebirah_spin_top_bit   0x2000
value ebirah_final_shot     0x40      # the Pop bumper: the final blow (or bit 42, unnamed)
value ebirah_final_mask_lo  0x40      # the field once every counter is 0 (0x814cc writes 0x400_00000040)
value ebirah_final_mask_hi  0x400
value ebirah_reminder_event 0x14e
value ebirah_stage_award_count 3
value ebirah_stage_msg      0xce3     # award screen messages 0xce3 / 0xce4 / 0xce5 (left / top / shield), 0xce6 the final blow
value ebirah_stage_lamp_left  0x71    # 113 LEFT SPINNER, the lamp the stage screen names
value ebirah_stage_lamp_top   0x96    # 150 TOP SPINNER
value ebirah_stage_lamp_shield 0x7a   # 122 ATTACK MECHA (the shield ramp spinner's insert)
value ebirah_lamp_entries   6
