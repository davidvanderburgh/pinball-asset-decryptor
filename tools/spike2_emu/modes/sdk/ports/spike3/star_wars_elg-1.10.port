# ---- scenes (PAD-1284): a mode's screen goes in hud, its clip on video_bank's surface - the same ids
# the program names ----
scene hud                  7b4db7ef1fa23cfb5e115a2a2c89d46a6a2ebc4a/835949dafb924a7cfeb0ec0fe2a3a4d8696d4aea
scene video_bank           60ed7e5036b8ce09d35a3e101ea6fc1380b37d97

# ---- PAD-1285: a held coil's names and board address, the game's modes a mode keeps from starting;
# PAD-1286: the game's modes whose books a mode of ours may wait on (done_name) ----
text right_gate_label     Right control gate
text right_gate_drive     8 2 255 64 128
text held_coils           right_gate
text block_name_0         Inner Loop
text block_name_1         Orbits
text block_name_2         Ramps
text done_name_0          Captive Multiball

# ---- text ----
text example_start_shot     Death star target

# not carried (to measure on Spike 3): 1 scene

# PAD-1326: co-op play - the message table and its "BALL %d" line (portcoop.message_lines_a64: the same
# number as the Spike 2 build's), the line that says whose turn it is
data message_table          0x006c96e8
value coop_ball_msg          1255

# ---- attract (PAD-1328): the attract mode's page table, read off this program's sequencer (its child create at 0x13889c); an owner's attract items play between its pages ----
data  attract_table       0x006a45c0   # 28 entries {test, page}, 8-byte pointers (RELATIVE)
value attract_entry_size  16
value attract_page_at     8
value attract_count       28
site  attract_sleep       0x00315000 0x900021a1 0x910f4021
#   the attract pages' own clip loop: player_advance(player, ms) ; scene_show(player, 3) each frame
site  attract_show        0x001b4aa0 0xa9be53f3 0xaa0003f4
site  player_advance      0x001b4a70 0xaa0003e1 0xb4000080
