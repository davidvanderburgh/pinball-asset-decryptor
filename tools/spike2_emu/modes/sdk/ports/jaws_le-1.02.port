data event_current          0x008adafc
#   resource_manager: a base 0x7db1a0 + field 0x80; the base derived from 2 places, e.g. 0x3bac44+0x54
data resource_manager       0x008a2248
#   typeinfo_resource: derived from 2 places, e.g. 0x264fc+0x34
data typeinfo_resource      0x006db088
