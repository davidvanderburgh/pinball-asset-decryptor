# ---- PAD-1327 (emulator-proven 2026-11-16: entry on the menu, picked, game 1 played as Competition): the start
# menu (CHOOSE YOUR MODE OF PLAY), a menu of game-mode table indices read off this program's
# own menu function 0x27fbd0; the frame point `ldr w23, [x27, w20, sxtw #2]`: the index under the cursor once the press
# has moved it (w20), the list x27 = sp+0x1d0 (room for 12: 0x200 is the next object), the count in w22.
# Prolonged Competition (comp.cfg) appends Competition's index again and letters its name message while the cursor
# is on it; the game itself plays the pick as Competition (Standard's index once it is on).
site comp_menu_frame     0x002809d0 0xb874db77 0x9409bac3
value comp_menu_frame_moved      1
value comp_menu_frame_list_at    464
value comp_menu_frame_count_reg  22
value comp_menu_frame_cap        12
value comp_menu_frame_cursor_reg 20
value comp_menu_index            3   # COMPETITION (its flag alone)
value comp_menu_index_msg        1921   # ALL RANDOMNESS REMOVED
value comp_menu_end_index        1   # STANDARD
value comp_menu_end_msg          1916   # NORMAL PLAY
# the message lookup's: a u64 count, a pointer to the u16 remap (the table is PAD-1326's line above)
data message_count          0x00834a08
data message_remap          0x00ae3618

