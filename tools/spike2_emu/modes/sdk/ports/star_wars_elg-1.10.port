# ---- the game's own modes (item 164): the framework's game flags (set 0x28a27c / clear 0x28a234; the bitmap
# pointer at [holder + 4], its size in bits at the count global). Each mode's start sets a flag of its
# own that its stop clears; multiballs are the balls-in-play count's:
#   86  Inner loop 0x6bcc0
#   88  Orbits 0x6ad3c
#   87  Ramps 0x5eff0
data game_flags             0x005929cc
value game_flags_at         4
data game_flag_count        0x004a7b00
value mode_flag_1           86
value mode_flag_2           88
value mode_flag_3           87
