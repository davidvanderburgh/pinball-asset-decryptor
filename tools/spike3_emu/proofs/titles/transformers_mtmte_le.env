# Transformers LE 0.96 (Spike 3) - its card, port and switch names for s3proof.sh / play.sh / s3census.sh
# (TITLE=transformers_mtmte_le, PAD-1293). Bits are ports/spike3/transformers_mtmte_le-0.96.port's switch lines (ids
# from the rig census beside this file, each 3 below its device-table rank): Megatron target left 0x4; Right orbit 0x2,
# Center loop 0x2000000, Left orbit 0x200000000.
CARD=${CARD:-transformers_mtmte_le-0_96_0_spike3.Release.64G.sdcard-secure.raw}
PORTNAME=${PORTNAME:-transformers_mtmte_le-0.96.port}
TRIGGER_SW=${TRIGGER_SW:-MEGATRON TARGET LEFT}
SHOT_SWS=${SHOT_SWS:-RIGHT ORBIT|CENTER LOOP|LEFT ORBIT}
EARLY_SWS=${EARLY_SWS:-LEFT ORBIT|RIGHT ORBIT}
TRIGGER_BITS=${TRIGGER_BITS:-0x4}
SHOT_BITS=${SHOT_BITS:-0x202000002}
COINS=${COINS:-4}
START_HOLD_MS=${START_HOLD_MS:-0}
FLIP_SWS=${FLIP_SWS:-LEFT FLIPPER BUTTON|RIGHT FLIPPER BUTTON}       # PAD-1327: this title's own names (L/R FLIPPER BUTTON do not exist here)
