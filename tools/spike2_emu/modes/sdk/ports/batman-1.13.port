site show_priority    0x003b1520 0xe30a3abc 0xe3403076
#   award_screen: located (strict) [TMNT Pro 1.58]
site award_screen     0x001e6794 0xe92d4070 0xe24dd008
#   string_new: PLT stub for _ZNSsC1EPKcRKSaIcE [TMNT Pro 1.58]
site string_new       0x000167c8 0xe28fc606 0xe28ccabf
#   dynamic_cast: PLT stub for __dynamic_cast [TMNT Pro 1.58]
site dynamic_cast     0x000161e0 0xe28fc606 0xe28ccabf
#   resource_get: placed through 3 callers, e.g. the bl at 0x1def20 [TMNT Pro 1.58]
site resource_get     0x003e9a0c 0xe92d43f0 0xe1a04000
#   set_text: located (strict) [TMNT Pro 1.58]
site set_text         0x004d4a24 0xe92d47f0 0xe1a06000
#   surface_state: located (strict) [TMNT Pro 1.58]
site surface_state    0x004e3f40 0xe5900230 0xea004903
#   player_advance: located (strict) [TMNT Pro 1.58]
site player_advance   0x001e6b70 0xe2501000 0x012fff1e
#   display_draw: located (strict) [TMNT Pro 1.58]
site display_draw     0x0041257c 0xe3520001 0x812fff1e
#   hook_dispatch: the event bus's dispatch (cmp r0, #191; push): the one function of that shape
site hook_dispatch    0x003f6644 0xe35000bf 0xe92d4038
#   the end of ball: no ball_end site - the framework's end of ball at 0x422550 dispatches bus 0x30 (its sequence 0x31, 0x32, 0x30, then the bonus 0x23, 0x24) - drain a ball to prove it (value ball_end_event below)
#   switch_edge: the framework's per-switch call in its switch drain (generation A: r0 = the switch id, called for every edge the game acts on, before the level is stored) - press the switches to prove it
site switch_edge      0x00345848 0xe92d4010 0xe1a04000
#   switch_drain: the drain itself, never hooked: an edge counts only when switch_edge is called from it
site switch_drain     0x00345fa0 0xe92d4ff0 0xe30b9f30

