# A wizard mode for Pirates-v01.01: it starts once the player has played these 4 of the game's own
# modes in one game, or when PAD WIZARD is picked on the attract menu (hold both flipper
# buttons a second in attract).  Every key: tools/jjp_emu/MODES.md
name = PAD Wizard
title = PAD WIZARD
start_all = PirateMode AtWorldsEndMultiball BlackPearlMultiball DeadMansChestMultiball
game_type = PAD WIZARD
shots = switch_upf_target_1 switch_l_orbit_hi switch_l_ramp_made
points = 3000000
points_ladder = rising
multiball = 3 20
seconds = 0
sound_start = se_VS_Tortuga_Intro
sound_shot = se_Fanfare_TreasureHoard_Jackpot
