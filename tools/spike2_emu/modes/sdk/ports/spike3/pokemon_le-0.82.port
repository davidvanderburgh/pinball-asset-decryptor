value comp_menu_frame_cap        12
value comp_menu_frame_cursor_reg 21
value comp_menu_index            6   # COMPETITION (its flag alone)
value comp_menu_index_msg        1914   # ALL RANDOMNESS REMOVED
value comp_menu_end_index        1   # STANDARD
value comp_menu_end_msg          1912   # NORMAL PLAY
