# ---- the game's own modes (item 164): the framework's game flags - set 0x152d60 / write 0x152da8 / get
# 0x152df8, the bitmap pointer at [0x594a40 + 4], its size in bits at [0x4beff8]. Each dinosaur mode's
# start sets a flag of its own (the stock table's start functions): Brachiosaurus 0x72bdc 39, Stegosaurus
# 0x90860 40, Triceratops 0x92760 41, Pteranodon 0x79a34 42, Gallimimus 0x78f1c 43. Multiballs are the
# balls-in-play count's.
data game_flags             0x00594a40
value game_flags_at         4
data game_flag_count        0x004beff8
