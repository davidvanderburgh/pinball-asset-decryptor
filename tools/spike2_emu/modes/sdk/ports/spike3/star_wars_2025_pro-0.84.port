# ---- PAD-1327 (emulator-proven 2026-11-16: a LEFT press from the first entry reaches ours, picked, game 1 played as
# Competition): the start menu (CHOOSE YOUR MODE OF PLAY), a menu of game-mode table indices read off this program's
# own menu function 0x1d1220; the frame point `ldr w21, [x0, w22, sxtw #2]`: the index under the cursor once the press has moved it (w22), the list sp+0x168 (room for 4: 0x178 is a string), the count at sp+156.
# Prolonged Competition (comp.cfg) appends Competition's index again and letters its name message while the cursor
# is on it; the game itself plays the pick as Competition (Standard's index once it is on).
site comp_menu_frame     0x001d1f1c 0xb876d815 0x94031de4
value comp_menu_frame_moved      1
value comp_menu_frame_list_at    360
value comp_menu_frame_count_at   156
value comp_menu_frame_cap        4
value comp_menu_frame_cursor_reg 22
value comp_menu_index            2   # COMPETITION (its flag alone)
value comp_menu_index_msg        1910   # ALL RANDOMNESS REMOVED
value comp_menu_end_index        1   # STANDARD
value comp_menu_end_msg          1908   # NORMAL PLAY
# the message lookup's: a u64 count, a pointer to the u16 remap, a table of 8-byte record pointers
data message_count          0x0062e320
data message_remap          0x008073a8
data message_table          0x007770d8

