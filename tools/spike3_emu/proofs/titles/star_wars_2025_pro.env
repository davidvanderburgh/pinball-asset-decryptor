# Star Wars 2025 Pro 0.84 (Spike 3) - its card, port and switch names for s3proof.sh / play.sh (TITLE=star_wars_2025_pro,
# PAD-1291). Bits are ports/spike3/star_wars_2025_pro-0.84.port's switch lines (ids measured: star_wars_2025_pro-0.84.switch_ids): Right
# target 0x80; Left orbit 0x400, At-at target 0x800, Right orbit 0x800000.
CARD=${CARD:-star_wars_2025_pro-0_84_0.Release.64G.sdcard-secure.raw}
PORTNAME=${PORTNAME:-star_wars_2025_pro-0.84.port}
TRIGGER_SW=${TRIGGER_SW:-RIGHT TARGET}
SHOT_SWS=${SHOT_SWS:-LEFT ORBIT|AT-AT TARGET|RIGHT ORBIT}
EARLY_SWS=${EARLY_SWS:-LEFT ORBIT|RIGHT ORBIT}
TRIGGER_BITS=${TRIGGER_BITS:-0x80}
SHOT_BITS=${SHOT_BITS:-0x800c00}
COINS=${COINS:-4}
START_HOLD_MS=${START_HOLD_MS:-0}
GAME_MB_SW=${GAME_MB_SW:-JUMP RAMP ENTER OPTO|JUMP RAMP EXIT OPTO}   # the centre ramp: "%d CENTER RAMP SHOTS TO START MULTIBALL"
GAME_MB_TIMES=${GAME_MB_TIMES:-6}
FLIP_SWS=${FLIP_SWS:-LEFT FLIPPER BUTTON|RIGHT FLIPPER BUTTON}       # PAD-1327: this title's own names (L/R FLIPPER BUTTON do not exist here)
