  "extra_vbs": "B2SOff = True   ' PAD: the bridge owns Controller; DOF calls must not reach it\nSub PadLFlip(e)\n\tbFlippersEnabled = True\n\tSolLFlipper e\nEnd Sub\nSub PadRFlip(e)\n\tbFlippersEnabled = True\n\tSolRFlipper e\nEnd Sub\nSub PadScoopOut(e)   ' the RIGHT VUK: the ball sank into scoop, it comes back out of scoop1\n\tIf e Then\n\t\tController.Switch(1101) = False\n\t\tIf scoop.BallCntOver > 0 Then\n\t\t\tscoop.DestroyBall\n\t\t\tscoop1.CreateSizedBallWithMass BallSize / 2, BallMass\n\t\t\tscoop1.Kick 270, 3\n\t\t\tPlaySoundAt \"fx_popper\", scoop\n\t\tEnd If\n\tEnd If\nEnd Sub\nSub PadMagnet(e)   ' the JET PACK MAGNET: the tribute's magnet by the captive ball\n\tIf e Then\n\t\tmMagnet.MagnetOn = True\n\tElse\n\t\tReleaseMagnetBalls\n\tEnd If\nEnd Sub\n",
  "retrofit_timers": {
