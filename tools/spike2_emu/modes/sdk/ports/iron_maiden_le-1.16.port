site dynamic_cast     0x00016068 0xe28fc605 0xe28cca18
#   resource_get: placed through 3 callers, e.g. the bl at 0x1def20 [TMNT Pro 1.58]
site resource_get     0x002682e4 0xe92d43f0 0xe1a04000
#   set_text: located (strict) [TMNT Pro 1.58]
site set_text         0x00403d9c 0xe92d47f0 0xe1a06000
#   surface_state: located (strict) [TMNT Pro 1.58]
site surface_state    0x004132b8 0xe5900230 0xea004903
#   player_advance: located (strict) [TMNT Pro 1.58]
site player_advance   0x003769dc 0xe2501000 0x012fff1e
#   display_draw: located (strict) [TMNT Pro 1.58]
site display_draw     0x0026cd3c 0xe3520001 0x812fff1e
#   hook_dispatch: the event bus's dispatch (cmp r0, #191; push): the one function of that shape
site hook_dispatch    0x001cac54 0xe35000bf 0xe92d4038
#   the end of ball: no ball_end site - the framework's end of ball at 0x112b54 dispatches bus 0x30 (its sequence 0x31, 0x32, 0x30, then the bonus 0x23, 0x24) - drain a ball to prove it (value ball_end_event below)
#   switch_edge: the framework's per-switch call in its switch drain (generation A: r0 = the switch id, called for every edge the game acts on, before the level is stored) - press the switches to prove it
site switch_edge      0x0028f604 0xe92d4010 0xe1a04000
#   switch_drain: the drain itself, never hooked: an edge counts only when switch_edge is called from it
site switch_drain     0x0028fd5c 0xe92d4ff0 0xe30c9df0

