site show_priority    0x001ad42c 0xe30335e4 0xe3403b66
#   award_screen: located (strict) [TMNT Pro 1.58]
site award_screen     0x002a3e74 0xe92d4070 0xe24dd008
#   string_new: PLT stub for _ZNSsC1EPKcRKSaIcE [TMNT Pro 1.58]
site string_new       0x00016628 0xe28fc605 0xe28cca88
#   dynamic_cast: PLT stub for __dynamic_cast [TMNT Pro 1.58]
site dynamic_cast     0x00016040 0xe28fc605 0xe28cca88
#   resource_get: placed through 3 callers, e.g. the bl at 0x1def20 [TMNT Pro 1.58]
site resource_get     0x003d900c 0xe92d43f0 0xe1a04000
#   set_text: located (strict) [TMNT Pro 1.58]
site set_text         0x00450a4c 0xe92d47f0 0xe1a06000
#   surface_state: located (strict) [TMNT Pro 1.58]
site surface_state    0x0045ff68 0xe5900230 0xea004903
#   player_advance: located (strict) [TMNT Pro 1.58]
site player_advance   0x002a4250 0xe2501000 0x012fff1e
#   display_draw: located (strict) [TMNT Pro 1.58]
site display_draw     0x00275470 0xe3520001 0x812fff1e
#   hook_dispatch: the event bus's dispatch (cmp r0, #191; push): the one function of that shape
site hook_dispatch    0x00323ea8 0xe35000bf 0xe92d4038
#   the end of ball: no ball_end site - the framework's end of ball at 0x234948 dispatches bus 0x30 (its sequence 0x31, 0x32, 0x30, then the bonus 0x23, 0x24) - drain a ball to prove it (value ball_end_event below)
#   switch_edge: the framework's per-switch call in its switch drain (generation A: r0 = the switch id, called for every edge the game acts on, before the level is stored) - press the switches to prove it
site switch_edge      0x001b01a0 0xe92d4010 0xe1a04000
#   switch_drain: the drain itself, never hooked: an edge counts only when switch_edge is called from it
site switch_drain     0x001b08f8 0xe92d4ff0 0xe30a9430

