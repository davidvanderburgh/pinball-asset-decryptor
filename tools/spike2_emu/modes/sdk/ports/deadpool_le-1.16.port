# ---- events ----
event game_start      0x4d     # the Start that began a game
event ball_start      0x25     # game start, and after each ball's bonus (at once after a tilted ball)
event ball_end        0x34     # each drain that ended a ball, and a tilted ball's
event bonus_start     0x27     # just after a drain's end of ball; not after a tilt
event bonus_end       0x28     # a few seconds later, before the next ball starts
event tilt_warning    0xc6     # each of the first two tilt pendulum hits (Godzilla's 0xc8)
event tilt            0xc4     # the third hit (Godzilla's 0xc6)
event game_over       0x47     # the last ball's drain, after its bonus

