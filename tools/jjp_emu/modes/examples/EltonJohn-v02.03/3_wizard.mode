# A wizard mode for EltonJohn-v02.03: it starts once the player has played these 4 of the game's own
# modes in one game, or when PAD WIZARD is picked on the attract menu (hold both flipper
# buttons a second in attract).  Every key: tools/jjp_emu/MODES.md
name = PAD Wizard
title = PAD WIZARD
start_all = PianoRampMode SongBeatMode SongMode SuperSpinnerMode
game_type = PAD WIZARD
shots = switch_target_left switch_ramp_left_made switch_ramp_right_made
points = 3000000
points_ladder = rising
multiball = 3 20
seconds = 0
sound_start = se_Fanfare_ChampMB_Intro
sound_shot = se_Fanfare_ChampMB_SuperJackpot
