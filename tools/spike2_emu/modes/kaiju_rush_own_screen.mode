# kaiju_rush_own_screen.mode - KAIJU RUSH with A SCREEN OF ITS OWN (item 131).
#
# The same mode as kaiju_rush.mode, except for its screen. That one borrows tesla
# strike's message ids 3159/3160 and points them at our words for the length of the
# mode, so a tesla award shown in that window reads KAIJU RUSH. This one borrows
# nothing: its screen is a node authored into the in-game HUD scene 32e6ae28 by
# modes/mode_screen.py - our art (a texture the card never had) and a Text - and
# mode.so finds it by name, keeps it hidden until the mode runs, writes its words
# live with the game's own set-text, and hides it again.
#
# EMULATOR-PROVEN on Godzilla Pro 1.15, NOT hardware-proven. It needs the scene:
#   modes/mode_screen.py <stock 32e6ae28 scene.radium> <out> --name KaijuRush_Screen
#       --title "KAIJU RUSH" --words "1,000,000 A SHOT"
# installed at assets/lcd/auto_loaded/32e6ae28.../scene.radium. Without it the mode
# logs "own screen not found" and shows nothing - and the scene without this mode
# would leave the screen on the glass all game, so the two go together.
#
name           KAIJU RUSH

# What starts it: a shot mask, and how many of them in one ball.
# 0x08000000 is the Maser Target (the switch -> shot bit map is in MODE_API.md).
trigger        0x08000000 3

# How long it runs, in seconds, on the 60 Hz tick clock. No game timer is free.
seconds        30

# The shots that score while it runs: powerlines 28-30 and both ramps, 20-21.
shots          0x70300000

# The first shot is worth this, the second twice this, and so on.
award          1000000

# The screen: a node of our own (see the top of this file). No message id is touched.
screen_scene   32e6ae280ddaec08e203a02289bb39a04968e7b0
screen_node    KaijuRush_Screen
screen_text    KaijuRush_Screen.KaijuRush_Screen_Words
# seconds the total stays up after the mode ends
restore_after  6

# The lights: the game's own light runner, with a live show event made current.
# Owner 538 and these two commands are tesla strike's own award pair.
light_owner    538
light_on       blele --sweep 0 --lts 224 --red 0 --green 255 --blue 0 --freq 10 --use_alpha 1 --alpha 255
light_off      blele --sweep 1 --lts 224 --fade 20 --rgb 0 --freq 10 --delay_start 15 --end 1

# The countdown, in the game's own voice: one callout at N seconds left, the
# counting callout whose variant is (seconds - 1) for 5 down to 1, and one at the end.
callout_at     10 1291
callout_count  1287
callout_end    1295
