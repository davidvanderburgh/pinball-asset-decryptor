# A multiball of the mode's own for GunsNRoses-v03.03: 3 balls, 10 s ball save, one ball left
# ends it (seconds = 0: no clock).  Every key: tools/jjp_emu/MODES.md
name = PAD Multiball
title = PAD MULTIBALL
start = switch_orbit_left_hi
shots = switch_target_jam switch_orbit_left_hi switch_orbit_right_hi
points = 2000000
seconds = 0
multiball = 3 10
add_ball = switch_target_jam 1
coil_shot = coil_knocker
sound_shot = se_Fanfare_GnR_Amps_Jackpot
