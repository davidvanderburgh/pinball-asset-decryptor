switch 34   0x1000000000000000 Action button
switch 60   0x2000000000000000 Left flipper button
switch 59   0x4000000000000000 Right flipper button
# the Action button's RGB light (lamp 97, I/O group 5 index 5/4/7, on the cabinet front), tied to its shot:
# a mode that lights its shots lights the button
lamp 282,283,284  0x1000000000000000 ACTION BUTTON  # lamp 97, I/O group 5 index 5, the cabinet front

# The battle rule's shot handler, RuleBattle::v[25] (vtable 0x642690 + 8 + 100; shot mask in r2:r3): a lit
# ramp counts toward a battle (0x100000 Left ramp, 0x200000 Right ramp), a lit scoop (hi 0x20) opens the
# BATTLE SELECTION screen (the process it creates waits for effect 132). A blocking mode hides those bits.
site block_battle_shots       0x00124b3c 0xe92d40f8 0xe1a06002
value block_battle_lo         0x00300000
value block_battle_hi         0x00000020
# PAD-398: every rule of the game's that reads shots (game_mode_blocks.read_rules, from the game
# program): while a mode of ours runs, each sees none of its shots unless the mode keeps it (no
# block_rule_lo/hi lines: every bit); the battle rule is block_battle_shots. `text block_rule_name_<n>`
# is what the Modes tab lists.
