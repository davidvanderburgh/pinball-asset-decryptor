# Fallout LE 0.82 (Spike 3) - play.sh's switch names, sourced by s3proof.sh with TITLE=fallout_le (PAD-1288).
# Shot bits from ports/spike3/fallout_le-0.82.port: Junk target 0x40; Pop target-left 0x80, Radio tower target
# 0x8000, 3 Bank-top 0x10000 (SHOT_BITS: the mode files' trigger and shots on this title).
TRIGGER_SW="JUNK TARGET"
SHOT_SWS="POP TARGET-LEFT|RADIO TOWER TARGET|3 BANK-TOP"
EARLY_SWS="POP TARGET-LEFT|3 BANK-TOP"
START_HOLD_MS=0                 # no GAME SETUP screen on Fallout
ATTRACT_WAIT=110                # its Fat Man steppers home first (docs/plans/spike3_emulation.md, Stage 7)
COINS=4
AFTER_START_SWS="ACTION BUTTON" # the character select
TRIGGER_BITS=0x40               # Junk target
SHOT_BITS=0x18080               # Pop target-left, Radio tower target, 3 Bank-top
FLIP_SWS="LEFT FLIPPER BUTTON|RIGHT FLIPPER BUTTON"      # PROOF=edge
NOHANDLER_SWS="RIGHT SLINGSHOT|LEFT POP BUMPER"          # PROOF=edge
