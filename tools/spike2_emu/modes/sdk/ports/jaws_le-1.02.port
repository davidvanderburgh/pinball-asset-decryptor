site award_screen     0x003c7714 0xe92d4070 0xe24dd008
#   string_new: PLT stub for _ZNSsC1EPKcRKSaIcE
site string_new       0x00015b98 0xe28fc607 0xe28cca9d
#   dynamic_cast: PLT stub for __dynamic_cast
site dynamic_cast     0x000167ec 0xe28fc607 0xe28cca9d
