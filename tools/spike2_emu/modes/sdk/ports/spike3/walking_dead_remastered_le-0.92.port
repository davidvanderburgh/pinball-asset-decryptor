# ---- PAD-1369: the game's challenge games, read off this program's own code (Star Wars ELG's PAD-1330 sites
# paired across and checked by shape) ----
# The balls-per-game getter (setting 80 / the player's game mode's own / Insider Connected's) is built into its
# callers, as on ELG: the balls of a player and of the current player are whole functions; the ball-number set
# (two ways), the last-ball test and the ball's end read it into a register and compare - set to 1 there in a
# mode's challenge game. The take-an-extra-ball test is the ball's end's first call after its bus question; the
# end of the ball (end(w0, w1): status bits 0x202, devices off) and the launch button's handler (flags 13 / 12,
# fire 8) as ELG's
site challenge_balls      0x003609f0 0xb0002241 0xf9468421
site challenge_balls_2    0x00360ab0 0xd100c3ff 0xb0002241
site challenge_balls_at_0 0x00360bd8 0x6b1302bf 0x54000308
site challenge_balls_at_1 0x00360c2c 0x6b1302bf 0xb0002240
site challenge_balls_at_2 0x00360cc0 0x6b13029f 0x52800000
site challenge_balls_at_3 0x00360e7c 0x913c42c0 0x39400401
site challenge_extra_ball 0x004cfec0 0xd0001e42 0x39688041
site challenge_end_ball   0x0036e4f0 0xf00021c2 0xf942f042
site ball_launch          0x00369010 0xa9be53f3 0xb00028f3
value challenge_on_flag   18   # FG_PLAYER_CHALLENGE_MODE_ACTIVE, read off the program's FG_ names
value challenge_balls_at_0_reg 19
value challenge_balls_at_1_reg 19
value challenge_balls_at_2_reg 19
value challenge_balls_at_3_reg 20
value ball_launch_flag       12   # FG_MBDEV_AUTO_PLUNGER_BALL_IN_DEVICE
value ball_launch_wait_flag  13   # FG_MBDEV_AUTO_PLUNGER_PLAYER_CONTROL
value challenge_menu_slot      -1   # a plain challenge: nothing of the game's to stop
value challenge_menu_kind      3    # kind 3 sets flag 18 alone (0x1f01e0): the plain challenge game
value challenge_menu_caption   1920   # CHALLENGE
value challenge_page_title_max 18   # as Star Wars ELG's (the same 800x480 one-screen cabinet)
