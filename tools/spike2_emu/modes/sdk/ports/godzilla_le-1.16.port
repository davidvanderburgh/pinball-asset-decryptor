scene attract               394c4a037fb26e12f536c42b2677bfed831f5c98

# ---- examples a template mode can use on this game ------------------------------------------------
text example_start_shot     Maser target
text example_clip           Mothra_godzilla_attack20
text example_lights_on      blele --sweep 0 --lts 224 --red 0 --green 255 --blue 0 --freq 10 --use_alpha 1 --alpha 255
text example_lights_off     blele --sweep 1 --lts 224 --fade 20 --rgb 0 --freq 10 --delay_start 15 --end 1

# ---- sound requests (item 150) - located by port_tool.py from Pro 1.15's, words read from this ELF --
# sound_play(req) / sound_nth(req, n) start a request, sound_stop(req) stops every channel playing
# it (0 = all), sound_active(req) is 1 while a channel plays it. sound_worker is what every entry
# point funnels into; only the census instrument (sdk/sound_census.c) hooks it.
site sound_play       0x0043d2ac 0xe92d4010 0xe307ed28
site sound_nth        0x0043d460 0xe92d4010 0xe307ed28
site sound_active     0x0043da20 0xe59f3034 0xe2831e62
site sound_stop       0x0043db78 0xe92d40f8 0xe1a06000
site sound_worker     0x0043c898 0xe92d4ff0 0xe2507000
# 8 channels x 196 B (+180 serial, +184 request, +188 voices playing), 8 x 20 B delayed queue,
# RuleCities' request -> request hash map
data sound_channels         0x007f7e34
data sound_queue            0x007f86a8
data city_variants          0x007ba680
# the request table (20 B a request: +8 sid list, +16 priority, +17 steal flag) and the u32
# holding how many requests it has - both read by the worker (pm_sound_priority)
data sound_requests         0x00784844
data sound_request_count    0x0061c28c
# item 150 follow-up (pad_mode.h pm_sound_playing / pm_sound_fade): the channel struct and its
# voices, read off the worker (0x43c898 on Premium 1.16) and the release (+0x5c: eight voice
# pointers, one per bit of +188); a voice's u16 at +48 is the codec's volume step (1/3 dB each)
value sound_channel_count       8
value sound_channel_size        196
value sound_channel_request     184
value sound_channel_voices      188
value sound_channel_bus         189
value sound_channel_voice_ptrs  92
value sound_voice_volume        48

# ---- the game's own modes (item 140): cmode_manager's own queries, CALLED, never hooked -------------
# Placed by port_tool.py from godzilla_pro-1.15.port: every site by a strict signature, the manager
# derived from 2 places. The manager's code on this build is instruction-for-instruction Pro 1.15's
# (only cmode virtual offsets past slot 48 differ), with the same 27 mode ids and kinds.
# Emulator-proven (item 140, run 3, card godzilla_le-1_16_0): all four verified at boot; all three
# answered 0 in plain play; battle and any answered 1 while a natural battle (id 12, Ebirah) was
# active, multiball and any while a Godzilla multiball (id 1) was, and 0 again once each ended.
# v[10]: any active mode not flagged 0x20
site stock_any_running 0x000d41b0 0xe92d4070 0xe30f66a0
# v[15]: an active mode with kind & 0x8 (the kaiju battles, and Megalon and Gigan multiball)
site stock_battle_running 0x000d43d0 0xe92d4070 0xe30f66a0
# v[22]: an active mode with (kind & 0x21) == 1 (every multiball)
site stock_multiball_running 0x000d45a8 0xe92d40f8 0xe30f66a0
data stock_mode_manager       0x007b0ce4

# ---- events (item 147): MODE_SDK.md, Events ----------------------------------------------------
# The ids are Pro 1.15's, and every function that dispatches them has the same shape here
# (armxref.py args: 267 dispatch sites against Pro's 265, only ids 0x0a/0x0b differ). The
# site events were placed by port_tool.py and each lines up with its Pro function's callers
# (11 multiball starts, 16 multiball stops, 7 calls from RuleSkillShot::v[25]).
# Measured on this build (item 147, run3c and run3d, 2026-09-17, the runtime with these lines
# and event_probe.c beside it, one marked game each): game_start and ball_start fired at the
# Start and in no other window, and a mode file with `starts_on event ball_start` started in
# the same millisecond; skill_shot fired within 50 ms of switch 46 closing 1 s after the
# plunge, and not for a hit 11 s later; multiball_start fired on a forced godzilla multiball
# (the glass showed its start screen) and started a mode file; multiball_end fired when the
# probe called the stop function by hand (the game's own call at a multiball's end was not
# seen on this build); tilt_warning fired on the first two pendulum hits and tilt on the
# third. NOT measured here: ball_end, bonus_start, bonus_end and game_over - run3c's drain
# after four switch hits did not end the ball (a control boot without these lines did the
# same), so no ball ended but by the tilt; item 150's run1 ended balls on this build after
# about 46 switch hits per ball.
site hook_dispatch    0x003fcdf8 0xe35000cf 0xe92d4038
event game_start      0x4d
event ball_start      0x25
event ball_end        0x34
event bonus_start     0x27
event bonus_end       0x28
event tilt_warning    0xc8
event tilt            0xc6
event game_over       0x47
site skill_shot_award 0x00171910 0xe92d4ff0 0xe24dd03c
site mball_start      0x000d75e0 0xe92d40f8 0xe1a04000
site mball_stop       0x000d76bc 0xe92d4010 0xe1a04000
event skill_shot      site skill_shot_award
event multiball_start site mball_start
event multiball_end   site mball_stop

# ---- item 146: the battle roster (Godzilla only) --------------------------------------------------
# Drafted by port_tool.py from the Pro 1.15 port and read at the desk; EMULATOR-PROVEN (item 146 run5,
# 2026-09-17, a godzilla_le-1_16_0 card copy with MOTHRA in slot 0): a claimed pick started the mode, its end
# lit the ramps again, and a stock pick (Megalon) started the game's battle through the same hook.
# RuleBattle::start_slot is 0x124980 here (`cmp r1,#6` bound, the same 12-byte slot records), called by
# the selector's pick at 0x190cac with the singleton 0x7b0c70; it loads the battle's START at 0x1249c8.
# The constructor copies the seven records from the rodata table at 0x64272c. roster_done (0x124924) is
# Pro's 0x122014: clear the qualified byte, then the re-light at 0x1248cc.
site roster_start      0x001249c8 0xe5903000 0xe5933020
site roster_done       0x00124924 0xe92d4010 0xe1a04000
data rule_battle            0x007b0c70
value roster_slots          7
value roster_vec_at         8
value roster_record_size    12
value roster_id_at          4
value roster_qualified_at   83
# the start of a picked mode waits this long (mode_file.c): the selection screen fades and plays its intro clip,
# gone by +2.4 s (run4, Pro 1.15); at +3.3 s the mode's start screen showed (run5, this build)
value roster_start_after_ms 3000
# the selection screen's slot table (derived by port_tool.py from 2 places; the same seven records and callout ids as
# Pro 1.15, read from both programs): a claimed slot is made silent (pm_roster_callout; item 146 fix-1). Run on this build
# in item 146 run7: slot 0's id read 1888 -> 0 at the claim, 207 by `roster_callout 207`, 1888 at release (PAD_PEEK)
data roster_screen_table     0x0070e62c
value roster_screen_record_size 32
value roster_callout_at      28
# RuleCities' "done in this city" (0x1387ac, Pro's 0x135394; the battle stop at 0x125568 calls it with bit 1 on the
# singleton 0x7b0e78, derived by port_tool.py from 2 places): pm_roster_done does the same (item 146 fix-2). Run7 on
# this build: a picked mode's end logged player 1's city 0 mask 0 -> 2, and a watcher read the same from the game
site roster_city_done  0x001387ac 0xe92d4070 0xe24dd010
data rule_cities             0x007b0e78
value roster_city_bit        1
value roster_city_index_at   20
value roster_city_vec_at     44
value roster_city_record_size 16

# ---- display priority (item 154 display; MODE_SDK.md "Display priority") --------------------------------------
# Placed by signature from Pro 1.15 (strict); the effect and layered tables match Pro's record for record. Run here
# with display_probe.c (r1): the layered display is effect 29 (priority 1); shot awards are layered displays 37-48,
# 101 (110-117) or effects 126 / 128 through waiters at 176; jackpots effect 79 (184); tilt warning 33 (241).
site display_effect_start 0x00439194 0xe92d47f0 0xe2516000
site display_effect_next  0x00439578 0xe30735a4 0xe340307f
site display_priority_now 0x00439a0c 0xe5d0000e 0xe12fff1e
site layered_priority     0x0003cfcc 0xe92d4008 0xe5903058
# item 157: the layered display's WAITER (the process body its start tail-calls: r0 the display, r1 the frames it
# may wait, r2 its priority). A display a hold would keep waiting is dropped here: while one waits the game draws
# no frames (MODE_SDK.md "A waiting layered display freezes the glass").
site layered_waiter      0x00052ea4 0xe92d4ff0 0xe304c4f8
data display_effects         0x007f75a4
data layered_displays        0x0070bc3c
value display_host           29
value display_mode_level     184
value display_now_at         0xc
value display_priority_at    0xe
value layered_record_size    16
value layered_priority_at    12
value layered_wait_for_at    0xa0
value layered_waiter_call    0x00052efc
value effect_waiter_call     0x00052d58
value layered_fg_at          0x58
value layered_fg_flags_at    0x60

# ---- named inserts (item mode-leds): MODE_SDK.md "Lights: named inserts" ----------------------------
# The game's lamp LAYERS (lamp groups): the active list's head is the word after the free list's at
# lamp_layers; each group holds a pointer to one 40-byte slot per light (+0), its priority (+4), its
# event (+16) and the next group (+20). Every frame the compositor walks the list bottom to top and
# each slot whose byte +3 is set gives its light the level at +2 (fade at +8). Read at the desk off
# this build (allocator 0x3a6010, pool 0x3a623c, compositor 0x4d7d04) (the allocator, the pool, the compositor).
data lamp_layers            0x007d408c
data light_count            0x007d38f0
value lamp_slot_size        40
value lamp_slot_level       2
value lamp_slot_alpha       3
value lamp_slot_fade        8
value lamp_slot_used        36
value lamp_group_prio       4
value lamp_group_next       20
# the fade time a held insert's level carries: the game's own in-play inserts carry 3 (read live, RUN 2)
value lamp_fade             3
