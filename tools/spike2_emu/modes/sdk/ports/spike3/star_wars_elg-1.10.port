# not carried (64-bit layout, measure it): value tank_level_at         0x70      # + 4 * player
# not carried (64-bit layout, measure it): value tank_value_at         0x80      # + 8 * player, u64: this player's tank value (+150,000 a kill)
# not carried (64-bit layout, measure it): value tank_destroyed_at     0xa8      # u32: tanks destroyed this wave (4/5/6/7/8 by level light the Maser)
# not carried (64-bit layout, measure it): value tank_multiplier_at    0xac      # the Maser multiplier (3 a wave, -1 per tank that reaches the target)
# not carried (64-bit layout, measure it): value tank_maser_hits_at    0xb0      # + 4 * (player - 1)
# not carried (64-bit layout, measure it): value tank_path_entries     6
# not carried (64-bit layout, measure it): value tank_path_entry_size  16
