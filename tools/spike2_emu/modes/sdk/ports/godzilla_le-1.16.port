site caward_build     0x0002f8d4 0xe92d4ff8 0xe1a0b000  # (award, 0, value lo, hi, [sp] 0): tank pays half a kill into it
site caward_add_scaled 0x0002fcdc 0xe92d4ff8 0xe1a09002  # (award, notify, index, multiplier): the Maser hit
site show_start       0x001f34d4 0xe92d47f0 0xe2508000  # (id) -> the show's record, or 0
site game_event       0x001def88 0xe92d47f0 0xe1a09000  # (id, _, value lo, hi, [sp] a, [sp+8] b lo, hi)
site event_post_replacing 0x003f33e0 0xe92d4070 0xe1a05001  # (id, handler, flags) -> the event record or 0
