# Shell scripts must always check out with LF line endings — they run
# under bash (WSL / Linux), where stray CR bytes break heredoc
# terminators and `#!` shebang lines.  Without this, core.autocrlf on a
# Windows checkout would rewrite them to CRLF and corrupt them (this is
# exactly what broke the GDRE Tools installer — see installer/install_gdre.sh).
*.sh text eol=lf
# the Spike 3 proofs' title files are sourced by bash and their mode files read on the rig (PAD-1288)
tools/spike3_emu/proofs/** text eol=lf

# Dockerfiles are consumed by `docker build` (macOS Spooky/JJP flows).
# A CRLF after a `\` line-continuation in a multi-line RUN breaks the
# build, and the build context dir is bundled verbatim into the .app —
# so a Windows checkout must NOT rewrite these to CRLF.
Dockerfile text eol=lf
**/Dockerfile text eol=lf

# The pinned Mode SDK runtime the app ships (item 127): never line-ending converted.
# The rule that takes effect is in tools/spike2_emu/.gitattributes (a deeper file
# wins, and that one says `* text eol=lf`); this line alone did nothing.
tools/spike2_emu/modes/sdk/prebuilt/mode.so binary
tools/spooky_emu/modes/unity/prebuilt/** binary
# git hooks run under sh: LF, like every other shell script here
.githooks/* text eol=lf

# The Docker image's own files (PAD-837) run in the container: scripts with
# no .sh to match above, and a CR would break their #! lines.
installer/docker/root/** text eol=lf

# The pinned aarch64 kit list xgcc.sh reads under bash (PAD-1295): LF like the script
*.pins text eol=lf
# PAD-1289: the Spike 3 proof rig's title files are sourced by bash and its mode files read on the rig: LF
tools/spike3_emu/proofs/**/*.env text eol=lf
tools/spike3_emu/proofs/**/*.cfg text eol=lf
# JJP mode files and port reports go onto a Linux machine as they are (PAD-1350)
tools/jjp_emu/modes/** text eol=lf

# PR #38: the card start script runs under the card's /bin/sh (a CR after
# #!/bin/sh stops it), and the ARM payloads are pinned by SHA-256.
pinball_decryptor/resources/ssh/sshd text eol=lf
pinball_decryptor/resources/ssh/armv7/** binary
pinball_decryptor/resources/ssh/aarch64/** binary
# PAD-1467: the Wi-Fi option's card files: a kernel module, and scripts the card's /bin/sh runs
pinball_decryptor/resources/wifi/88x2bu.ko binary
pinball_decryptor/resources/wifi/pad-wifi-band text eol=lf
pinball_decryptor/resources/wifi/padwifi text eol=lf
pinball_decryptor/resources/remote/pad-buttons.so binary
pinball_decryptor/resources/remote/pad-buttons.c text eol=lf
pinball_decryptor/resources/remote/t_buttons.c text eol=lf
pinball_decryptor/resources/remote/build.sh text eol=lf
