# ---- callouts, heard in the emulator 2026-09-24 (item 163): the runtime's callout / callout_nth
# sites played each id and the game's audio was transcribed: countdown 572 (clips 1-5 said "ONE", "2", "3", "FOUR", "Five"); ten_seconds 591 ("Hurry, make the shot!"); time_up 663 ("Time's up, loser!")
callout countdown           572
callout ten_seconds         591
callout time_up             663
value countdown_first 1

# ---- clip v2 (item 164): the video bank scene's VideoSurface, played on the surface itself - the
# game draws it. The typed find is find_node + 0x2f4; the surface's functions sit at layout A's
# distances from surface_state (godzilla_le-1.16), each prologue equal to it. A clip was seen on the glass in
# the emulator 2026-09-25 (item 164).
site surface_find     0x004e9480 0xe92d4070 0xe24dd008
site surface_set_video 0x004e0b64 0xe5d030d4 0xe92d4ff0
site surface_play     0x004de970 0xe5d030d4 0xe92d43f0
site surface_stop     0x004de120 0xe5d030d4 0xe92d40f0
# PAD-725: the surface's own seek, length and position (PAD-530's, from Bond 1.06): a mode's clip the game's own
# clip took the surface from comes back where it would be by then. Placed by the James Bond LE 1.06 recipe at
# its distances from surface_play (-0x36c / -0x6b4 / -0x510), each proven by its call: the player function it
# calls calls gst_element_seek / query_duration / query_position.
site surface_seek     0x004de604 0xe92d43f0 0xe1a07003
site surface_duration 0x004de2bc 0xe5d030d4 0xe92d40f0
site surface_position 0x004de460 0xe5d030d4 0xe92d40f0
# PAD-725: the game's reel (a clip of its own kept in step with a song): its tick waits while a clip of
# ours has the bank's surface. Found by what it calls (surface_position, surface_seek, surface_play) and
# its prologue (push; mov r4, r0; ldr r0, [r0, #0x1c]; cmp r0, #0; popeq).
site reel_tick       0x001cdedc 0xe92d47f0 0xe1a04000

