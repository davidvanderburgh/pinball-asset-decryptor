# A multiball of the mode's own for ToyStory-v02.04: 3 balls, 10 s ball save, one ball left
# ends it (seconds = 0: no clock).  Every key: tools/jjp_emu/MODES.md
name = PAD Multiball
title = PAD MULTIBALL
start = switch_left_ramp_diverted_made
shots = switch_jet_target switch_left_ramp_diverted_made switch_right_ramp_made
points = 2000000
seconds = 0
multiball = 3 10
add_ball = switch_jet_target 1
coil_shot = coil_knocker
sound_shot = se_Fanfare_TAC_Jackpot
