site display_draw     0x003629b0 0xe3520001 0x812fff1e
#   hook_dispatch: the event bus's dispatch (cmp r0, #191; push): the one function of that shape
site hook_dispatch    0x00434fb4 0xe35000bf 0xe92d4038
#   the end of ball: no ball_end site - the framework's end of ball at 0x28f868 dispatches bus 0x30 (its sequence 0x31, 0x32, 0x30, then the bonus 0x23, 0x24) - drain a ball to prove it (value ball_end_event below)
#   switch_edge: the framework's per-switch call in its switch drain (generation A: r0 = the switch id, called for every edge the game acts on, before the level is stored) - press the switches to prove it
site switch_edge      0x001bf3d8 0xe92d4010 0xe1a04000
#   switch_drain: the drain itself, never hooked: an edge counts only when switch_edge is called from it
site switch_drain     0x001bfb30 0xe92d4ff0 0xe3059d78

