# ---- sound requests (item 150) - read off this ELF (MODE_API.md, the play chain) --------------
# sound_play(req) / sound_nth(req, n) start a request, sound_stop(req) stops every channel playing
# it (0 = all), sound_active(req) is 1 while a channel plays it. sound_worker is what every entry
# point funnels into; only the census instrument (sdk/sound_census.c) hooks it.
site sound_play       0x002a3108 0xe92d4010 0xe308e990
site sound_nth        0x002a32bc 0xe92d4010 0xe308e990
site sound_active     0x002a387c 0xe59f3034 0xe2831e62
site sound_stop       0x002a39d4 0xe92d40f8 0xe1a06000
site sound_worker     0x002a26f4 0xe92d4ff0 0xe2507000
# 8 channels x 196 B (+180 serial, +184 request, +188 voices playing), 8 x 20 B delayed queue,
# RuleCities' request -> request hash map
data sound_channels         0x007b8a9c
data sound_queue            0x007b9310
data city_variants          0x007a7268
# the request table (20 B a request: +8 sid list, +16 priority, +17 steal flag) and the u32
# holding how many requests it has - both read by the worker (pm_sound_priority)
data sound_requests         0x00771530
data sound_request_count    0x0060bd34
# item 150 follow-up (pad_mode.h pm_sound_playing / pm_sound_fade): the channel struct and its
# voices, read off the worker (0x43c898 on Premium 1.16) and the release (+0x5c: eight voice
# pointers, one per bit of +188); a voice's u16 at +48 is the codec's volume step (1/3 dB each)
value sound_channel_count       8
value sound_channel_size        196
value sound_channel_request     184
value sound_channel_voices      188
value sound_channel_bus         189
value sound_channel_voice_ptrs  92
value sound_voice_volume        48

# ---- the game's own modes (item 140): cmode_manager's own queries, CALLED, never hooked -------------
# Each is a virtual of the manager singleton (called with it in r0) that walks the manager's 27 modes
# and returns 1 if one is ACTIVE (its per-player running flag is set, or its timer's or start event
# is live) and its kind (+8) matches. Kind bits: 0x1 multiball, 0x8 battle. Desk-decoded from the
# code (MODE_SDK.md, "The game's own modes"); the runtime calls them only while a player is up.
# Emulator-proven (item 140, runs 1-2): all three answered 0 in plain play; battle and any answered 1
# while a battle (id 13) was active, multiball and any while a Godzilla multiball (id 1) was, and each
# went back to 0 when the mode ended with the ball in play.
# v[10]: any active mode not flagged 0x20
site stock_any_running 0x000d1e20 0xe92d4070 0xe30d6ed8
# v[15]: an active mode with kind & 0x8 (the kaiju battles, and Megalon and Gigan multiball)
site stock_battle_running 0x000d2040 0xe92d4070 0xe30d6ed8
# v[22]: an active mode with (kind & 0x21) == 1 (every multiball)
site stock_multiball_running 0x000d2218 0xe92d40f8 0xe30d6ed8
data stock_mode_manager       0x0079d954

# ---- events (item 147): measured with event_probe.c, one marked game (MODE_SDK.md, Events) -----
# The bus's dispatch, hooked to count ids; each id below fired in exactly the marked windows
# named in its comment (run1, 2026-09-16) and in no other window of that game.
site hook_dispatch    0x004bb42c 0xe35000cf 0xe92d4038
event game_start      0x4d     # the Start that began a game; the mode manager resets its modes on it
event ball_start      0x25     # game start and ~12 s after each drain (after the bonus); not after the last ball
event ball_end        0x34     # each drain that ended a ball, and a tilted ball's
event bonus_start     0x27     # 20 ms after a drain's end of ball; not after a tilt
event bonus_end       0x28     # 12 s later, just before the next ball starts
event tilt_warning    0xc8     # the first two tilt pendulum hits
event tilt            0xc6     # the third hit; the mode manager ends its modes on it
event game_over       0x47     # the last ball's drain, and never before
# Not broadcast on the bus: a CALL of these functions is the event (site events). Run2
# (2026-09-16, the runtime with these lines): skill_shot fired once, 0.5 s after switch 46
# was pressed 1 s after the plunge, and not for a press 15 s later; multiball_start fired
# on a forced godzilla multiball (the glass showed its start screen) and started a mode
# file on it; multiball_end fired when that multiball stopped, which in the emulator was
# at the end of the ball, not when two of its three balls had drained.
site skill_shot_award 0x0016df38 0xe92d4ff0 0xe24dd03c
site mball_start      0x000d521c 0xe92d40f8 0xe1a04000
site mball_stop       0x000d52f8 0xe92d4010 0xe1a04000
event skill_shot      site skill_shot_award   # RuleSkillShot's award
event multiball_start site mball_start        # cmode_mball's start, called by every multiball's start
event multiball_end   site mball_stop         # cmode_mball's stop, reached by every multiball's stop

# ---- item 146: the battle roster (Godzilla only) --------------------------------------------------
# RuleBattle::start_slot (0x122070) loads the picked battle's START here: r0 = the battle's mode
# object, r1 = its mode id. The runtime's hook swaps r0 when a mode claims that slot (pm_roster_claim).
site roster_start     0x001220b8 0xe5903000 0xe5933020
# RuleBattle's "a battle is over" for the player up (0x122014: clear the qualified byte at +83+player,
# re-light the ramps). The game gets there when its battle stops; pm_roster_done() calls it when a picked mode ends.
site roster_done      0x00122014 0xe92d4010 0xe1a04000
# the RuleBattle singleton: its slot vector begins at +8, 12-byte records {slot, mode id, 0}, copied by
# its constructor from the rodata table at 0x631f44 (a literal-pool load, which port_tool.py does not
# place, so it is not a `data` line): 0 Ebirah 12, 1 Titanosaurus 13, 2 Gigan 14, 3 Megalon 15,
# 4 King Ghidorah 16, 5 Megalon & Gigan 6, 6 King Ghidorah & Gigan 17
data rule_battle            0x0079d8e0
value roster_slots          7
value roster_vec_at         8
value roster_record_size    12
value roster_id_at          4
value roster_qualified_at   83
# the start of a picked mode waits this long (mode_file.c): the selection screen fades and plays its intro clip,
# gone by +2.4 s; with 3000 the mode started 3001 ms after the pick (item 146 run4). With no wait no start screen
# was seen (run2, run3: it came while the selector was closing); at +3.3 s it showed on Premium 1.16 (run5)
value roster_start_after_ms 3000
# the selection screen's slot table (.data, 32-byte records: the art node name at +20, the progress node at +24, a u16
# callout id at +28 = 1888 1918 1894 1910 0 0 0; its code plays nothing for 0). A claimed slot is made silent, and its id
# put back on release (pm_roster_callout, mode file `roster_callout`; item 146 fix-1)
data roster_screen_table     0x006fc8a4
value roster_screen_record_size 32
value roster_callout_at      28
# RuleCities' "done in this city" (0x135394: cities, bit): RuleBattle's stop calls it with bit 1 whatever the outcome, so
# pm_roster_done does too; the index/vector/record values bound the call (item 146 fix-2). Run8 on this build: a picked
# mode's end set player 1's city 0 mask 0 -> 2, and a drained stock battle's own stop set the same bit
site roster_city_done  0x00135394 0xe92d4070 0xe24dd010
data rule_cities             0x0079dae8
value roster_city_bit        1
value roster_city_index_at   20
value roster_city_vec_at     44
value roster_city_record_size 16

