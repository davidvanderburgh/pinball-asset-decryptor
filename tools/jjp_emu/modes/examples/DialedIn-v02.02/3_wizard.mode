# A wizard mode for DialedIn-v02.02: it starts once the player has played these 4 of the game's own
# modes in one game, or when PAD WIZARD is picked on the attract menu (hold both flipper
# buttons a second in attract).  Every key: tools/jjp_emu/MODES.md
name = PAD Wizard
title = PAD WIZARD
start_all = DisasterMode MiniMode BettyQuickMultiball DronesGoneWildQuickMultiball
game_type = PAD WIZARD
shots = switch_target_away switch_ramp_left_made_far switch_ramp_left_made_near
points = 3000000
points_ladder = rising
multiball = 3 20
seconds = 0
sound_start = se_Fanfare_hack_OnslaughtStart
sound_shot = se_Fanfare_Arm_SuperJackpot
