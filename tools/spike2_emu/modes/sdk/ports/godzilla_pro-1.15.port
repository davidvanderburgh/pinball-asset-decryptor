# the slots on THIS build: the shot handler and the mask getter are ONE LOWER than Premium 1.16's
value stock_slot_start      8
value stock_slot_end        10
value stock_slot_stop       11
value stock_slot_running    12
value stock_slot_shot_entry 15
value stock_slot_mask       44
value stock_running_at      0x1b
value stock_level_at        0x3c
value stock_award_at        0x50
