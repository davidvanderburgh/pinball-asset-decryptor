  "extra_vbs": "\n'---- PAD (map extra_vbs): GOTG's mechs, driven by the machine's coils\nSub PadRightScoop(e)\n\tIf e Then\n\t\tbsLeftScoop.SolOut True\n\t\tLeftScoopK.IsDropped = 0\n\t\tvpmTimer.AddTimer 100, \"LeftScoopK.IsDropped = 1 '\"\n\tEnd If\nEnd Sub\nSub PadOrbDropUp(e)\n\tIf e Then\n\t\tOrbTarget1.IsDropped = False\n\t\tController.Switch(1047) = False\n\tEnd If\nEnd Sub\nSub PadOrbDropDown(e)\n\tIf e Then\n\t\tOrbTarget1.IsDropped = True\n\t\tController.Switch(1047) = True\n\tEnd If\nEnd Sub\nSub PadOrbitGates(e)\n\tLoopGateLeft.Open = e\n\tGate002.Open = e\nEnd Sub\n\n' Groot's mouth stays open (the machine's jaw is a node-board motor the table\n' cannot follow) and his trough holds up to four balls on GROOT TROUGH 1..4;\n' the inside-the-Orb target stands back up (the machine's is a standup); the\n' Orb's blocking wall stays out of the way. Run from vpmTimer's slow updates.\nClass PadGotgMechs\n\tPrivate mSwapped, mOrbDown\n\tPrivate Sub Class_Initialize\n\t\tmSwapped = False\n\t\tmOrbDown = 0\n\tEnd Sub\n\tPublic Sub Reset\n\tEnd Sub\n\tPublic Sub Update\n\t\tIf Not mSwapped Then\n\t\t\tIf IsObject(bsGrootKicker) Then\n\t\t\t\tSet bsGrootKicker = PadGrootStack\n\t\t\t\tmSwapped = True\n\t\t\tEnd If\n\t\tEnd If\n\t\tIf GrootMouth.Collidable Then\n\t\t\tGrootMouth.Collidable = False\n\t\t\tGrootMouth.Z = -30\n\t\tEnd If\n\t\tIf OrbTarget1Disabled.Collidable Then\n\t\t\tOrbTarget1Disabled.Collidable = False\n\t\tEnd If\n\t\tIf OrbTarget2.IsDropped Then\n\t\t\tmOrbDown = mOrbDown + 1\n\t\t\tIf mOrbDown > 15 Then\n\t\t\t\tOrbTarget2.IsDropped = False\n\t\t\t\tmOrbDown = 0\n\t\t\tEnd If\n\t\tElse\n\t\t\tmOrbDown = 0\n\t\tEnd If\n\tEnd Sub\nEnd Class\nDim PadGrootStack : Set PadGrootStack = New cvpmBallStack\nPadGrootStack.InitSw 0, 1071, 1072, 1073, 1074, 0, 0, 0\nPadGrootStack.InitKick GrootKicker, 180, 20\nPadGrootStack.IsTrough = False\nDim PadMechs : Set PadMechs = New PadGotgMechs\nvpmTimer.EnableUpdate PadMechs, False, True\n\n' PinUP Player is the shadow game's display; the machine's LCD is the real one\nSet PuPlayer = New PadNoPuP\n",
